---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { site } from '../data/site';
import { roles, education } from '../data/experience';
import portrait from '../assets/photos/portrait.jpg';

const current = roles.find(r => r.current);
---
<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="eyebrow hero-eyebrow">{site.role}</p>
      <h1 id="hero-title">{site.name}</h1>
      <p class="lead hero-lead">
        I build fast websites in Astro, the PHP and MySQL backends behind them, and Android
        apps for small businesses in Nepal and Australia. Right now I also run the social
        media for an education consultancy, so I understand the marketing side of a project
        as well as the code.
      </p>

      <div class="hero-actions">
        <a href="#projects" class="btn btn-primary">See my projects <Icon name="arrow-right" /></a>
        <a href="#contact" class="btn btn-secondary">Get in touch</a>
      </div>

      <dl class="hero-facts">
        <div>
          <dt>Based in</dt>
          <dd>{site.location}</dd>
        </div>
        <div>
          <dt>Currently</dt>
          <dd>{current ? `${current.title}, ${current.org}` : 'Freelance'}</dd>
        </div>
        <div>
          <dt>Education</dt>
          <dd>{education[0].title}, {education[0].org}</dd>
        </div>
      </dl>
    </div>

    <figure class="hero-figure">
      <Image
        src={portrait}
        alt={`${site.name}, studio portrait`}
        width={560}
        densities={[1, 1.5, 2]}
        format="webp"
        quality={82}
        loading="eager"
        fetchpriority="high"
        class="hero-photo"
      />
    </figure>
  </div>
</section>

<style>
.hero {
  padding-block: clamp(3rem, 8vw, 6.5rem) clamp(3.5rem, 8vw, 6rem);
  border-bottom: 1px solid var(--line);
}

.hero-grid {
  display: grid;
  grid-template-columns: minmax(0, 1.25fr) minmax(0, .85fr);
  gap: clamp(2.5rem, 6vw, 5rem);
  align-items: center;
}

.hero-eyebrow { margin-bottom: 1.25rem; color: var(--accent-text); }
.hero-lead { margin-top: 1.5rem; max-width: 34em; }

.hero-actions {
  display: flex; flex-wrap: wrap; gap: .75rem;
  margin-top: 2rem;
}

.hero-facts {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 1.5rem;
  margin-top: 2.75rem;
  padding-top: 1.75rem;
  border-top: 1px solid var(--line);
}
.hero-facts dt {
  font-size: .8125rem; font-weight: 600;
  letter-spacing: .06em; text-transform: uppercase;
  color: var(--text-3);
  margin-bottom: .3rem;
}
.hero-facts dd { font-size: .9875rem; color: var(--text); line-height: 1.45; }

.hero-figure {
  position: relative;
  justify-self: end;
  width: min(100%, 26rem);
}
.hero-figure::before {
  content: '';
  position: absolute; inset: 1.25rem -1.25rem -1.25rem 1.25rem;
  border-radius: var(--radius-lg);
  background: var(--accent-soft);
  z-index: 0;
}
.hero-photo {
  position: relative; z-index: 1;
  width: 100%; aspect-ratio: 4 / 5;
  object-fit: cover; object-position: 50% 18%;
  border-radius: var(--radius-lg);
  border: 1px solid var(--line);
  box-shadow: var(--shadow-lg);
}

@media (max-width: 900px) {
  .hero-grid { grid-template-columns: 1fr; }
  .hero-figure { justify-self: start; width: min(100%, 20rem); order: -1; }
  .hero-photo { aspect-ratio: 1 / 1; object-position: 50% 22%; }
  .hero-figure::before { inset: 1rem -1rem -1rem 1rem; }
}
@media (max-width: 560px) {
  .hero-facts { grid-template-columns: 1fr; gap: 1rem; }
  .hero-actions .btn { flex: 1 1 auto; }
}
</style>
