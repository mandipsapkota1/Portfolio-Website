---
/**
 * Inline SVG icons. Stroke icons are drawn on a 24 grid at 1.75px so they
 * sit well next to Source Sans at text sizes; the three brand marks are the
 * official filled logos.
 */
export interface Props {
  name: keyof typeof stroke | keyof typeof filled;
  size?: number | string;
  class?: string;
  label?: string;
}

const stroke = {
  'arrow-right':    '<path d="M5 12h14"/><path d="m13 6 6 6-6 6"/>',
  'arrow-up-right': '<path d="M7 17 17 7"/><path d="M8 7h9v9"/>',
  'arrow-up':       '<path d="M12 19V5"/><path d="m6 11 6-6 6 6"/>',
  'download':       '<path d="M12 4v11"/><path d="m7 10 5 5 5-5"/><path d="M5 19h14"/>',
  'mail':           '<rect x="3.5" y="5.5" width="17" height="13" rx="2"/><path d="m4 7 8 6 8-6"/>',
  'phone':          '<path d="M6.6 3.5h3l1.5 4-2 1.3a10 10 0 0 0 5.6 5.6l1.3-2 4 1.5v3a2 2 0 0 1-2.2 2A16.5 16.5 0 0 1 4.6 5.7a2 2 0 0 1 2-2.2Z"/>',
  'map-pin':        '<path d="M12 21s6-5.6 6-11a6 6 0 0 0-12 0c0 5.4 6 11 6 11Z"/><circle cx="12" cy="10" r="2.2"/>',
