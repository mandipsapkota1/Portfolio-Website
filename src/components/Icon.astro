  'code':           '<path d="m8 7-5 5 5 5"/><path d="m16 7 5 5-5 5"/><path d="m14 4-4 16"/>',
  'briefcase':      '<rect x="3" y="7.5" width="18" height="12.5" rx="2"/><path d="M8.5 7.5V6a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v1.5"/><path d="M3 12.5h18"/>',
  'graduation':     '<path d="m2.5 9 9.5-4.5L21.5 9 12 13.5 2.5 9Z"/><path d="M6 11v4.5c0 1.5 2.7 3 6 3s6-1.5 6-3V11"/><path d="M21.5 9v5"/>',
  'globe':          '<circle cx="12" cy="12" r="8.5"/><path d="M3.5 12h17"/><path d="M12 3.5c2.5 2.6 3.7 5.4 3.7 8.5s-1.2 5.9-3.7 8.5c-2.5-2.6-3.7-5.4-3.7-8.5S9.5 6.1 12 3.5Z"/>',
  'sparkle':        '<path d="M12 3.5c.6 4.3 2.7 7.4 8.5 8.5-5.8 1.1-7.9 4.2-8.5 8.5-.6-4.3-2.7-7.4-8.5-8.5 5.8-1.1 7.9-4.2 8.5-8.5Z"/>',
