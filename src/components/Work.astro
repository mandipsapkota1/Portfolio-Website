---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { featured, projects } from '../data/projects';
import { omnidimEnabled } from '../lib/omnidim.js';
---
<section class="work section" id="work" aria-labelledby="work-title">
  <div class="container">
    <div class="section-head reveal">
      <p class="eyebrow">Selected work</p>
      <h2 id="work-title">Websites and apps that are out in the world</h2>
      <p class="lead">
        Client sites first, with a screenshot of each as it looks today, then the smaller
        projects and the code behind them.
      </p>
    </div>

    <div class="cases">
      {featured.map((p, i) => (
        <article class="case reveal" id={`work-${p.slug}`} aria-labelledby={`case-${p.slug}`}>
          <a
            class="case-media"
            href={p.live ?? p.code}
            target="_blank"
            rel="noopener"
            aria-label={`Open ${p.name}${p.live ? '' : ' on GitHub'}`}
            tabindex="-1"
          >
            <Image
              src={p.image}
              alt={p.imageAlt}
              widths={[640, 960, 1280]}
              sizes="(max-width: 900px) 100vw, 60vw"
              format="webp"
              quality={78}
              loading={i === 0 ? 'eager' : 'lazy'}
            />
          </a>

          <div class="case-body">
            <p class="eyebrow">{p.kicker}</p>
            <h3 id={`case-${p.slug}`}>{p.name}</h3>
            <p class="case-summary">{p.summary}</p>
            <p class="case-detail">{p.detail}</p>
            <ul class="tags" role="list">
              {p.tags.map(t => <li class="tag">{t}</li>)}
            </ul>
            <div class="case-links">
              {p.live && (
                <a href={p.live} class="link-arrow" target="_blank" rel="noopener">
                  Visit site <Icon name="arrow-up-right" />
                </a>
              )}
              {p.code && (
                <a href={p.code} class="link-arrow" target="_blank" rel="noopener">
                  View code <Icon name="github" />
                </a>
              )}
              {p.assistant && omnidimEnabled && (
                <button type="button" class="link-arrow" data-ai-open="chat">
                  Try the assistant <Icon name="message" />
                </button>
              )}
            </div>
          </div>
        </article>
      ))}
    </div>

    <div class="more">
      <div class="more-head reveal">
        <h3>More projects</h3>
        <p class="muted">Coursework, side projects and experiments, with the code on GitHub.</p>
      </div>
      <ul class="more-grid" role="list">
        {projects.map((p, i) => (
          <li class="more-item card reveal" style={`--reveal-delay:${(i % 3) * .06}s`}>
            <h4>{p.name}</h4>
            <p>{p.summary}</p>
            <div class="more-foot">
              <ul class="tags" role="list">
                {p.tags.map(t => <li class="tag">{t}</li>)}
              </ul>
              <div class="more-links">
                {p.code && (
                  <a href={p.code} class="icon-btn" target="_blank" rel="noopener" aria-label={`${p.name} on GitHub`}>
                    <Icon name="github" size={17} />
                  </a>
                )}
                {p.live && (
                  <a href={p.live} class="icon-btn" target="_blank" rel="noopener" aria-label={`Open ${p.name}`}>
                    <Icon name="arrow-up-right" size={18} />
                  </a>
                )}
              </div>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
.cases { display: grid; gap: clamp(3rem, 6vw, 5rem); }

.case {
  display: grid;
  grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
  gap: clamp(1.5rem, 4vw, 3.5rem);
  align-items: center;
}
.case:nth-child(even) .case-media { order: 2; }

.case-media {
  display: block;
  border-radius: var(--radius-lg);
  border: 1px solid var(--line);
  background: var(--surface);
  overflow: hidden;
  box-shadow: var(--shadow-md);
  transition: box-shadow .25s var(--ease-out), transform .25s var(--ease-out);
}
.case-media img {
  width: 100%; aspect-ratio: 1600 / 867;
  object-fit: cover; object-position: top;
  transition: transform .5s var(--ease-out);
}
.case-media:hover { box-shadow: var(--shadow-lg); }
.case-media:hover img { transform: scale(1.015); }

.case-body .eyebrow { margin-bottom: .6rem; }
.case-body h3 { font-family: var(--font-serif); font-size: clamp(1.5rem, 2.4vw, 1.9rem); font-weight: 500; letter-spacing: -.01em; }
.case-summary { margin-top: .875rem; font-size: 1.0625rem; }
.case-detail { margin-top: .75rem; color: var(--text-2); font-size: .9875rem; }
.case-body .tags { margin-top: 1.25rem; }

.case-links { display: flex; flex-wrap: wrap; gap: 1.25rem; margin-top: 1.25rem; }
.case-links .link-arrow { font-size: .9875rem; }

.more { margin-top: clamp(3.5rem, 7vw, 6rem); padding-top: clamp(2.5rem, 5vw, 3.5rem); border-top: 1px solid var(--line); }
.more-head { margin-bottom: 1.5rem; }
.more-head h3 { font-family: var(--font-serif); font-size: 1.6rem; font-weight: 500; }
.more-head p { margin-top: .35rem; }

.more-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 1rem;
}
.more-item {
  display: flex; flex-direction: column;
  padding: 1.375rem;
  transition: border-color .2s, box-shadow .2s;
}
.more-item:hover { border-color: var(--line-strong); box-shadow: var(--shadow-md); }
.more-item h4 { font-size: 1.0625rem; }
.more-item p { margin-top: .5rem; color: var(--text-2); font-size: .9375rem; flex: 1; }
.more-foot { display: flex; align-items: flex-end; justify-content: space-between; gap: .75rem; margin-top: 1.125rem; }
.more-links { display: flex; gap: .4rem; flex: none; }
.more-links .icon-btn { width: 2.25rem; height: 2.25rem; }

@media (max-width: 900px) {
  .case { grid-template-columns: 1fr; }
  .case:nth-child(even) .case-media { order: 0; }
  .more-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
}
@media (max-width: 600px) {
  .more-grid { grid-template-columns: 1fr; }
}
</style>
