---
/**
 * An isometric stack of the four layers a full stack build is made of. Pure
 * CSS 3D transforms (no library), so it costs nothing to load. The pointer
 * tilts the stack, and hovering a layer in the legend lifts that plate.
 * Everything inside the plates is abstract shape, so the scene is marked
 * decorative and the legend carries the words.
 */
const layers = [
  { id: 'ui',    name: 'Interface',      tech: 'Astro, HTML, CSS, JavaScript' },
  { id: 'app',   name: 'Application',    tech: 'PHP, Java and Kotlin for Android' },
  { id: 'data',  name: 'Data',           tech: 'MySQL, SQLite' },
  { id: 'infra', name: 'Infrastructure', tech: 'Cloudflare, DNS, Git' },
];
/* Bottom plate first so the top of the stack is drawn last */
const plates = [...layers].reverse();
---
<div class="stack-block">
  <div class="stack-scene" id="stack-scene" aria-hidden="true">
    <div class="stack-float">
      <div class="stack" id="stack" data-active="ui">
        {plates.map((l, i) => (
          <div class={`plate plate-${l.id}`} data-layer={l.id} style={`--i:${i}`}>
            <div class="plate-face">
              {l.id === 'ui' && (
                <>
                  <span class="s bar top"></span>
                  <span class="s block hero"></span>
                  <span class="s block card a"></span>
                  <span class="s block card b"></span>
                  <span class="s pill"></span>
                </>
              )}
              {l.id === 'app' && (
                <>
                  <span class="s gutter"></span>
                  <span class="s line l1"></span>
                  <span class="s line l2"></span>
                  <span class="s line l3 accent"></span>
                  <span class="s line l4"></span>
                  <span class="s line l5"></span>
                </>
              )}
              {l.id === 'data' && (
                <>
                  <span class="s cell c1"></span><span class="s cell c2"></span><span class="s cell c3"></span>
                  <span class="s cell c4 accent"></span><span class="s cell c5"></span><span class="s cell c6"></span>
                  <span class="s cell c7"></span><span class="s cell c8"></span><span class="s cell c9"></span>
                </>
              )}
              {l.id === 'infra' && (
                <>
                  <span class="s rack r1"></span>
                  <span class="s rack r2"></span>
                  <span class="s rack r3"></span>
                  <span class="s led"></span>
                </>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <ul class="stack-legend" role="list" id="stack-legend">
    {layers.map((l, i) => (
      <li>
        <button
          type="button"
          class="stack-key"
          data-layer={l.id}
          aria-pressed={i === 0 ? 'true' : 'false'}
        >
          <span class="stack-key-name">{l.name}</span>
          <span class="stack-key-tech">{l.tech}</span>
        </button>
      </li>
    ))}
  </ul>
  <p class="stack-caption">The layers of a typical build, and what I use at each</p>
</div>

<script>
  const scene  = document.getElementById('stack-scene');
  const stack  = document.getElementById('stack');
  const legend = document.getElementById('stack-legend');

  if (scene && stack && legend) {
    const keys = [...legend.querySelectorAll('.stack-key')];
    const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function setActive(id) {
      stack.dataset.active = id;
      keys.forEach(k => k.setAttribute('aria-pressed', String(k.dataset.layer === id)));
    }

    keys.forEach(k => {
      k.addEventListener('click', () => setActive(k.dataset.layer));
      k.addEventListener('focus', () => setActive(k.dataset.layer));
      if (finePointer) k.addEventListener('pointerenter', () => setActive(k.dataset.layer));
    });

    stack.querySelectorAll('.plate').forEach(p => {
      if (finePointer) p.addEventListener('pointerenter', () => setActive(p.dataset.layer));
    });

    /* Pointer parallax: a few degrees of tilt that follow the cursor and ease
       back when it leaves. Skipped on touch and under reduced motion. */
    if (finePointer && !reduce) {
      let raf = 0, tx = 0, tz = 0;
      const apply = () => {
        raf = 0;
        stack.style.setProperty('--tx', tx.toFixed(2) + 'deg');
        stack.style.setProperty('--tz', tz.toFixed(2) + 'deg');
      };
      scene.addEventListener('pointermove', e => {
        const r = scene.getBoundingClientRect();
        const nx = (e.clientX - r.left) / r.width  - .5;
        const ny = (e.clientY - r.top)  / r.height - .5;
        tx = -ny * 10;
        tz =  nx * 8;
        if (!raf) raf = requestAnimationFrame(apply);
      });
      scene.addEventListener('pointerenter', () => stack.classList.add('is-spread'));
      scene.addEventListener('pointerleave', () => {
        tx = 0; tz = 0;
        if (!raf) raf = requestAnimationFrame(apply);
        stack.classList.remove('is-spread');
      });
    }
  }
</script>

<style>
.stack-block { display: grid; gap: 1.25rem; }

/* ─── Scene ─── */
.stack-scene {
  position: relative;
  height: clamp(17rem, 34vw, 22rem);
  perspective: 1400px;
  perspective-origin: 50% 40%;
  overflow: visible;
}
.stack-float {
  position: absolute; inset: 0;
  display: grid; place-items: center;
  animation: stack-float 7s ease-in-out infinite;
}
@keyframes stack-float {
  0%, 100% { transform: translateY(0); }
  50%      { transform: translateY(-7px); }
}

.stack {
  --size: clamp(11rem, 22vw, 14.5rem);
  --gap: 44px;
  --tx: 0deg;
  --tz: 0deg;
  position: relative;
  width: var(--size); height: var(--size);
  transform-style: preserve-3d;
  transform: translateY(12%) rotateX(calc(58deg + var(--tx))) rotateZ(calc(-42deg + var(--tz)));
  transition: transform .7s var(--ease-out);
}
.stack.is-spread { --gap: 58px; }

/* ─── Plates ─── */
.plate {
  position: absolute; inset: 0;
  transform-style: preserve-3d;
  transform: translateZ(calc(var(--i) * var(--gap)));
  transition: transform .6s var(--ease-out), opacity .4s var(--ease-out);
}
.plate-face {
  position: absolute; inset: 0;
  border-radius: 12px;
  background: var(--surface);
  border: 1px solid var(--line-strong);
  box-shadow: 0 30px 50px -30px rgba(28, 24, 23, .45);
  transition: border-color .35s var(--ease-out), box-shadow .35s var(--ease-out), background-color .35s;
  overflow: hidden;
}
/* Thickness: a darker copy a few pixels below the face */
.plate::before {
  content: '';
  position: absolute; inset: 0;
  border-radius: 12px;
  background: var(--line-strong);
  transform: translateZ(-7px);
}

/* Focus follows the legend: the chosen plate lifts and the others step back */
.stack[data-active] .plate { opacity: .62; }
.stack[data-active="ui"]    .plate-ui,
.stack[data-active="app"]   .plate-app,
.stack[data-active="data"]  .plate-data,
.stack[data-active="infra"] .plate-infra { opacity: 1; transform: translateZ(calc(var(--i) * var(--gap) + 22px)); }
.stack[data-active="ui"]    .plate-ui    .plate-face,
.stack[data-active="app"]   .plate-app   .plate-face,
.stack[data-active="data"]  .plate-data  .plate-face,
.stack[data-active="infra"] .plate-infra .plate-face {
  border-color: var(--accent);
  box-shadow: 0 40px 60px -28px rgba(138, 28, 52, .45), 0 0 0 1px var(--accent);
}

/* ─── Abstract content, one motif per layer ─── */
.s { position: absolute; display: block; border-radius: 4px; background: var(--line-strong); }
.s.accent { background: var(--accent); }

/* Interface: a tiny page */
.plate-ui .bar.top { left: 10%; right: 10%; top: 10%; height: 5%; }
.plate-ui .block.hero { left: 10%; width: 46%; top: 24%; height: 28%; border-radius: 6px; }
.plate-ui .block.card.a { left: 60%; right: 10%; top: 24%; height: 12%; }
.plate-ui .block.card.b { left: 60%; right: 10%; top: 40%; height: 12%; }
.plate-ui .pill { left: 10%; width: 26%; top: 62%; height: 9%; border-radius: 999px; background: var(--accent); }

/* Application: lines of code */
.plate-app .gutter { left: 9%; top: 12%; bottom: 12%; width: 2px; border-radius: 1px; }
.plate-app .line { left: 16%; height: 6%; }
.plate-app .l1 { top: 14%; width: 52%; }
.plate-app .l2 { top: 27%; width: 66%; }
.plate-app .l3 { top: 40%; width: 34%; }
.plate-app .l4 { top: 53%; width: 58%; }
.plate-app .l5 { top: 66%; width: 44%; }

/* Data: a table */
.plate-data .cell { width: 22%; height: 22%; border-radius: 5px; }
.plate-data .c1 { left: 12%; top: 12%; } .plate-data .c2 { left: 39%; top: 12%; } .plate-data .c3 { left: 66%; top: 12%; }
.plate-data .c4 { left: 12%; top: 39%; } .plate-data .c5 { left: 39%; top: 39%; } .plate-data .c6 { left: 66%; top: 39%; }
.plate-data .c7 { left: 12%; top: 66%; } .plate-data .c8 { left: 39%; top: 66%; } .plate-data .c9 { left: 66%; top: 66%; }

/* Infrastructure: racks with one live light */
.plate-infra .rack { left: 12%; right: 12%; height: 14%; border-radius: 6px; }
.plate-infra .r1 { top: 16%; } .plate-infra .r2 { top: 43%; } .plate-infra .r3 { top: 70%; }
.plate-infra .led { right: 17%; top: 20%; width: 6%; height: 6%; border-radius: 999px; background: var(--accent); }

/* ─── Legend ─── */
.stack-legend { display: grid; gap: .375rem; }
.stack-key {
  width: 100%;
  display: grid; grid-template-columns: auto 1fr; align-items: baseline; gap: .75rem;
  padding: .7rem .875rem .7rem 1rem;
  border-radius: var(--radius);
  border: 1px solid var(--line);
  border-left-width: 3px;
  background: var(--surface);
  text-align: left;
  transition: border-color .2s, background-color .2s;
}
.stack-key:hover { border-color: var(--line-strong); }
.stack-key[aria-pressed="true"] { border-left-color: var(--accent); background: var(--surface-2); }
.stack-key-name { font-weight: 600; font-size: .9875rem; color: var(--text); }
.stack-key-tech { font-size: .875rem; color: var(--text-2); }

.stack-caption { font-size: .875rem; color: var(--text-3); }

@media (max-width: 560px) {
  .stack-key { grid-template-columns: 1fr; gap: .15rem; }
}

@media (prefers-reduced-motion: reduce) {
  .stack-float { animation: none; }
  .stack, .plate, .plate-face { transition: none; }
}
</style>
