---
import Icon from './Icon.astro';
import { site } from '../data/site';
import { omnidimEnabled, omnidimChatSrc, omnidimVoiceSrc, omnidimFrameBg } from '../lib/omnidim.js';
---
{omnidimEnabled && (
<div
  class="ai-agent"
  id="ai-agent"
  data-chat-src={omnidimChatSrc}
  data-voice-src={omnidimVoiceSrc}
>

  <button
    type="button"
    class="ai-launcher"
    id="ai-launcher"
    aria-expanded="false"
    aria-controls="ai-panel"
    aria-label="Open the assistant"
  >
    <span class="ai-orb" aria-hidden="true"><Icon name="sparkle" size={16} /></span>
    <span class="ai-launcher-txt">Ask my assistant</span>
  </button>

  <div
    class="ai-panel"
    id="ai-panel"
    role="dialog"
    aria-modal="false"
    aria-label="Assistant"
    inert
  >
    <div class="ai-modes">
      <div class="ai-tabs" role="tablist" aria-label="Assistant mode">
        <button
          type="button" class="ai-mode is-active" data-mode="chat"
          role="tab" aria-selected="true" aria-controls="ai-frame-chat"
        >
          <Icon name="message" size={16} /> Chat
        </button>
        <button
          type="button" class="ai-mode" data-mode="voice"
          role="tab" aria-selected="false" aria-controls="ai-frame-voice"
        >
          <Icon name="mic" size={16} /> Voice call
        </button>
      </div>
      <button type="button" class="ai-close" id="ai-close" aria-label="Close assistant">
        <Icon name="x" size={18} />
      </button>
    </div>

    <div class="ai-body">
      <div class="ai-loading" aria-hidden="true">
        <span></span><span></span><span></span>
      </div>
      <iframe
        id="ai-frame-chat"
        class="ai-frame is-active"
        title="Chat with the assistant"
        allow="microphone; autoplay; clipboard-write"
        referrerpolicy="strict-origin-when-cross-origin"
      ></iframe>
      <iframe
        id="ai-frame-voice"
        class="ai-frame"
        title="Voice call with the assistant"
        allow="microphone; autoplay; clipboard-write"
        referrerpolicy="strict-origin-when-cross-origin"
      ></iframe>
    </div>

    <p class="ai-foot">
      Answers come from an AI and can be wrong. For anything that matters,
      <a href={`mailto:${site.email}`}>email me</a>.
    </p>
  </div>

</div>
)}

<style define:vars={{ aiFrameBg: omnidimFrameBg }}>
/* ─────────────────────────────────────────────────────────────
   AI ASSISTANT
   Sits under the header (z 100) and above page content. The
   mobile nav is part of the header stack, so the panel hides
   whenever the nav is open.
   ───────────────────────────────────────────────────────────── */

/* ─── LAUNCHER ─── */
.ai-launcher {
  position: fixed;
  right: 1.25rem;
  bottom: calc(1.25rem + env(safe-area-inset-bottom, 0px));
  z-index: 90;

  display: inline-flex; align-items: center; gap: .6rem;
  height: 3.125rem; padding: 0 1.125rem 0 .625rem;
  border-radius: 999px;

  background: var(--text);
  color: var(--bg);
  border: 1px solid transparent;
  box-shadow: var(--shadow-lg);

  font-family: var(--font-sans);
  font-size: .9625rem; font-weight: 600;
  white-space: nowrap;

  opacity: 0; transform: translateY(10px);
  transition: opacity .4s var(--ease-out), transform .4s var(--ease-out), background-color .2s;
}
.ai-agent.ai-visible .ai-launcher { opacity: 1; transform: none; }

/* Steps above the footer's bottom line rather than covering it */
.ai-agent.ai-visible.ai-lifted .ai-launcher { transform: translateY(-3.5rem); }

.ai-launcher:hover { background: var(--accent); color: var(--accent-ink); }
.ai-launcher:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }

/* While the panel is open the launcher steps out of the way */
.ai-agent.ai-open .ai-launcher {
  opacity: 0; transform: translateY(8px) scale(.96);
  pointer-events: none;
}

.ai-orb {
  display: inline-flex; align-items: center; justify-content: center;
  width: 2rem; height: 2rem; border-radius: 999px;
  background: var(--accent); color: var(--accent-ink);
}

/* ─── PANEL ─── */
.ai-panel {
  position: fixed;
  right: 1.25rem;
  bottom: calc(1.25rem + env(safe-area-inset-bottom, 0px));
  z-index: 91;

  width: 23.5rem;
  max-width: calc(100vw - 2.5rem);
  height: 37.5rem;
  max-height: calc(100dvh - 7rem);

  display: flex; flex-direction: column; overflow: hidden;

  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-lg);

  opacity: 0; visibility: hidden;
  transform: translateY(12px) scale(.98);
  transform-origin: bottom right;
  /* visibility is stepped, not interpolated: it flips to visible the instant
     .open lands (so the panel can take focus straight away), and is deferred
     to the end of the fade on the way out. */
  transition: opacity .24s var(--ease-out), transform .24s var(--ease-out), visibility 0s linear .24s;
}
.ai-panel.open {
  opacity: 1; visibility: visible; transform: none;
  transition: opacity .24s var(--ease-out), transform .24s var(--ease-out), visibility 0s;
}

/* ─── MODE TOOLBAR ───
   The widget draws its own title bar inside the iframe, so this row carries
   no title of its own. It switches surface and closes. */
.ai-modes {
  display: flex; align-items: center; gap: .5rem;
  padding: .625rem;
  border-bottom: 1px solid var(--line);
  background: var(--surface);
  flex-shrink: 0;
}
.ai-tabs { display: flex; gap: .375rem; }

.ai-mode {
  display: inline-flex; align-items: center; gap: .4rem;
  height: 2.125rem; padding: 0 .8rem;
  border-radius: 999px;
  border: 1px solid var(--line);
  color: var(--text-2);
  font-family: var(--font-sans); font-size: .875rem; font-weight: 600;
  white-space: nowrap;
  transition: color .18s, border-color .18s, background-color .18s;
}
.ai-mode:hover { color: var(--text); border-color: var(--line-strong); }
.ai-mode.is-active { color: var(--accent-ink); background: var(--accent); border-color: var(--accent); }

.ai-close {
  margin-left: auto; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
  width: 2.125rem; height: 2.125rem; border-radius: 999px;
  border: 1px solid var(--line);
  color: var(--text-2);
  transition: color .18s, border-color .18s, background-color .18s;
}
.ai-close:hover { color: var(--text); border-color: var(--line-strong); background: var(--bg-sunken); }

/* ─── BODY / FRAMES ───
   Both surfaces stay mounted once used, so switching back and forth does not
   throw away the conversation. Each is only given a src on first use. */
.ai-body {
  position: relative; flex: 1; min-height: 0;
  background: var(--aiFrameBg);
}
.ai-frame {
  position: absolute; inset: 0; z-index: 1;
  width: 100%; height: 100%;
  border: 0; display: block;
  opacity: 0; visibility: hidden;
  transition: opacity .2s ease, visibility .2s;
}
.ai-frame.is-active { opacity: 1; visibility: visible; }

/* Loader covers whichever surface is still coming up */
.ai-loading {
  position: absolute; inset: 0; z-index: 2;
  display: flex; align-items: center; justify-content: center; gap: .4rem;
  background: var(--aiFrameBg);
  opacity: 0; visibility: hidden;
  transition: opacity .25s ease, visibility .25s;
}
.ai-agent.ai-busy .ai-loading { opacity: 1; visibility: visible; }
.ai-loading span {
  width: .4rem; height: .4rem; border-radius: 999px;
  background: #ffffff; opacity: .35;
  animation: ai-bounce 1.2s ease-in-out infinite;
}
.ai-loading span:nth-child(2) { animation-delay: .15s; }
.ai-loading span:nth-child(3) { animation-delay: .3s; }
@keyframes ai-bounce {
  0%, 80%, 100% { transform: translateY(0);    opacity: .3; }
  40%           { transform: translateY(-5px); opacity: .9; }
}

/* ─── PANEL FOOTER ─── */
.ai-foot {
  flex-shrink: 0;
  padding: .6rem 1rem .7rem;
  border-top: 1px solid var(--line);
  background: var(--surface);
  font-size: .8125rem; line-height: 1.45; color: var(--text-3);
}
.ai-foot a { color: var(--accent-text); font-weight: 500; }
.ai-foot a:hover { text-decoration: underline; }

/* ─────────────────────────────────────────────────────────────
   The mobile nav owns the screen while it is open.
   ───────────────────────────────────────────────────────────── */
body:has(#nav.is-open) .ai-launcher,
body:has(#nav.is-open) .ai-panel {
  opacity: 0 !important;
  visibility: hidden !important;
  pointer-events: none !important;
}

/* ─── RESPONSIVE ─── */
@media (max-width: 600px) {
  .ai-launcher {
    right: 1rem;
    bottom: calc(1rem + env(safe-area-inset-bottom, 0px));
  }
  .ai-panel {
    left: .75rem; right: .75rem;
    bottom: calc(.75rem + env(safe-area-inset-bottom, 0px));
    width: auto; max-width: none;
    height: min(78dvh, 37.5rem);
    max-height: calc(100dvh - 5.5rem);
  }
}

/* Icon-only launcher where a pill would crowd the viewport */
@media (max-width: 400px) {
  .ai-launcher { width: 3.125rem; padding: 0; justify-content: center; }
  .ai-launcher-txt { display: none; }
}

/* ─── REDUCED MOTION ─── */
@media (prefers-reduced-motion: reduce) {
  .ai-loading span { animation: none; opacity: .6; }
  .ai-launcher { transition: opacity .01s, background-color .2s; transform: none; }
  .ai-agent.ai-visible .ai-launcher,
  .ai-agent.ai-open .ai-launcher { transform: none; }
  .ai-agent.ai-visible.ai-lifted .ai-launcher { transform: translateY(-3.5rem); }
  .ai-panel { transition: opacity .01s, visibility .01s; transform: none; }
  .ai-panel.open { transform: none; }
  .ai-frame { transition: none; }
}

@media print {
  .ai-launcher, .ai-panel { display: none !important; }
}
</style>
