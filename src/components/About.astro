---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { site } from '../data/site';
import { languages } from '../data/experience';
import photo from '../assets/photos/pokhara.jpg';
---
<section class="about section section-sunken" id="about" aria-labelledby="about-title">
  <div class="container about-grid">
    <figure class="about-figure reveal">
      <Image
        src={photo}
        alt="Mandip sitting at a lakeside cafe at Phewa Lake, Pokhara, with the hills behind"
        width={720}
        densities={[1, 1.5, 2]}
        format="webp"
        quality={80}
        loading="lazy"
        class="about-photo"
      />
      <figcaption>Phewa Lake, Pokhara</figcaption>
    </figure>

    <div class="about-copy">
      <div class="section-head reveal">
        <p class="eyebrow">About</p>
        <h2 id="about-title">A developer who also ships the marketing</h2>
      </div>

      <div class="about-text reveal" style="--reveal-delay:.06s">
        <p>
          I am a BSc IT graduate from ISMT College in Kathmandu and I have been building
          for clients since 2023. Most of that work is websites for small businesses, built
          in Astro and deployed on Cloudflare, with PHP and MySQL behind the scenes when a
          project needs accounts, uploads or an admin panel.
        </p>
        <p>
          I started at Tivra Institute in Bharatpur, then spent a year at Maulakalika
          Networks in Gaindakot as an assistant application developer, moving from a three
          month internship into the full role. Since 2026 I have been handling social media
          for Oasis Education, which means planning content and producing the short form
          video that goes with it.
        </p>
        <p>
          Outside client work I build Android apps in Java and Kotlin, and I take security
          seriously: how logins and sessions are handled, and how the domains I run are
          configured. It is a habit from my degree that has stayed with me.
        </p>
      </div>

      <dl class="about-facts reveal" style="--reveal-delay:.12s">
        <div>
          <dt><Icon name="map-pin" size={18} /> Location</dt>
          <dd>{site.location}</dd>
        </div>
        <div>
          <dt><Icon name="globe" size={18} /> Languages</dt>
          <dd>{languages.join(', ')}</dd>
        </div>
        <div>
          <dt><Icon name="briefcase" size={18} /> Open to</dt>
          <dd>Freelance websites and Android apps, and frontend roles</dd>
        </div>
      </dl>

      <a href={site.cv} download={site.cvFilename} class="btn btn-secondary about-cv reveal" style="--reveal-delay:.16s">
        <Icon name="download" /> Download my CV
      </a>
    </div>
  </div>
</section>

<style>
.about-grid {
  display: grid;
  grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr);
  gap: clamp(2.5rem, 6vw, 5.5rem);
  align-items: start;
}

.about-figure { position: sticky; top: calc(var(--header-h) + 2rem); }
.about-photo {
  width: 100%; aspect-ratio: 4 / 5;
  object-fit: cover; object-position: 50% 45%;
  border-radius: var(--radius-lg);
  border: 1px solid var(--line);
  box-shadow: var(--shadow-md);
}
.about-figure figcaption {
  margin-top: .75rem;
  font-size: .875rem; color: var(--text-3);
}

.about-copy .section-head { margin-bottom: 1.75rem; }

.about-text { display: grid; gap: 1.1rem; color: var(--text-2); font-size: 1.0625rem; }
.about-text p { max-width: 38em; }

.about-facts {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 1.25rem;
  margin-top: 2.25rem;
  padding: 1.5rem;
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: var(--radius-lg);
}
.about-facts dt {
  display: flex; align-items: center; gap: .45rem;
  font-size: .8125rem; font-weight: 600;
  letter-spacing: .06em; text-transform: uppercase;
  color: var(--text-3);
  margin-bottom: .4rem;
}
.about-facts dt svg { color: var(--accent-text); }
.about-facts dd { font-size: .9875rem; line-height: 1.45; }

.about-cv { margin-top: 1.75rem; }

@media (max-width: 900px) {
  .about-grid { grid-template-columns: 1fr; }
  .about-figure { position: static; max-width: 24rem; }
  .about-photo { aspect-ratio: 5 / 4; object-position: 50% 55%; }
}
@media (max-width: 600px) {
  .about-facts { grid-template-columns: 1fr; padding: 1.25rem; }
}
</style>
