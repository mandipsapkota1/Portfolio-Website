---
/**
 * Veil, the web prototype of Mandip's one thumb timing game, served from this
 * domain so the project has a live link. The game itself lives in
 * public/play/veil (styles.css and js/); this page is only its shell.
 * It is a standalone document on purpose: the game owns the whole viewport.
 */
const title = 'Veil, strike what you cannot see';
const description =
  'A one thumb precision game by Mandip Sapkota. A shard of light crosses into the dark and you strike its marks from memory. Sixty marks, you need fifty.';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover,user-scalable=no" />
  <meta name="theme-color" content="#06070A" />
  <meta name="robots" content="noindex" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <link rel="stylesheet" href="/play/veil/styles.css" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
</head>
<body>
  <div id="stage">
    <canvas id="game"></canvas>
    <div id="ui"></div>
  </div>
  <a class="veil-back" href="/#projects">Back to mandipsapkota.com.np</a>

  <script is:inline src="/play/veil/js/config.js"></script>
  <script is:inline src="/play/veil/js/sim.js"></script>
  <script is:inline src="/play/veil/js/render.js"></script>
  <script is:inline src="/play/veil/js/audio.js"></script>
  <script is:inline src="/play/veil/js/main.js"></script>

  <style is:inline>
    .veil-back {
      position: fixed; top: max(10px, env(safe-area-inset-top)); left: 50%; transform: translateX(-50%); z-index: 50;
      padding: 6px 10px; border-radius: 999px;
      background: rgba(6, 7, 10, .55); color: rgba(242, 245, 250, .7);
      font: 500 12px/1 ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      letter-spacing: .02em; text-decoration: none;
      border: 1px solid rgba(242, 245, 250, .14);
      -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px);
    }
    .veil-back:hover, .veil-back:focus-visible { color: #f2f5fa; border-color: rgba(242, 245, 250, .4); outline: none; }
  </style>
</body>
</html>
